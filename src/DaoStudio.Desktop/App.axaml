<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DaoStudio.Desktop.App" RequestedThemeVariant="Dark">
  <Application.Resources>
    <Color x:Key="SystemAccentColor">#10B981</Color>
    <SolidColorBrush x:Key="SystemControlHighlightAccentBrush">#10B981</SolidColorBrush>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="Background" Value="#09090B"/>
      <Setter Property="Foreground" Value="#F4F4F5"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>
    <Style Selector="TextBlock.secondary">
      <Setter Property="Foreground" Value="#A1A1AA"/>
    </Style>
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="26"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#F4F4F5"/>
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#71717A"/>
      <Setter Property="LetterSpacing" Value="0.8"/>
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="#18181B"/>
      <Setter Property="BorderBrush" Value="#27272A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="18"/>
      <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style Selector="Border.metric">
      <Setter Property="Background" Value="#111114"/>
      <Setter Property="BorderBrush" Value="#27272A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Border.badge">
      <Setter Property="Background" Value="#064E3B"/>
      <Setter Property="BorderBrush" Value="#059669"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style Selector="Border.banner">
      <Setter Property="Background" Value="#0C1F1A"/>
      <Setter Property="BorderBrush" Value="#065F46"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Border.alertError">
      <Setter Property="Background" Value="#2A1215"/>
      <Setter Property="BorderBrush" Value="#7F1D1D"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Button">
      <Setter Property="Padding" Value="14,9"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Background" Value="#27272A"/>
      <Setter Property="Foreground" Value="#F4F4F5"/>
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#10B981"/>
      <Setter Property="Foreground" Value="#052E16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="#27272A"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="12,10"/>
    </Style>
    <Style Selector="Button.navActive">
      <Setter Property="Background" Value="#065F46"/>
      <Setter Property="BorderBrush" Value="#10B981"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="#ECFDF5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="12,10"/>
    </Style>
    <Style Selector="Button.chip">
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Background" Value="#1F2937"/>
      <Setter Property="BorderBrush" Value="#374151"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="#6EE7B7"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="#09090B"/>
      <Setter Property="BorderBrush" Value="#27272A"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="Background" Value="#09090B"/>
      <Setter Property="BorderBrush" Value="#27272A"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style Selector="Border.tourBackdrop">
      <Setter Property="Background" Value="#040406"/>
      <Setter Property="BorderBrush" Value="#14141A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="24"/>
    </Style>
    <Style Selector="Border.glowOrb">
      <Setter Property="Background" Value="#052E24"/>
      <Setter Property="BorderBrush" Value="#10B981"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="CornerRadius" Value="999"/>
      <Setter Property="BoxShadow" Value="0 0 36 4 #4010B981"/>
      <Style.Animations>
        <Animation Duration="0:0:2.2" IterationCount="Infinite" PlaybackDirection="Alternate">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0.45"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1.0"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Border.stageCard">
      <Setter Property="Background" Value="#09090B"/>
      <Setter Property="BorderBrush" Value="#1F2937"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="24"/>
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.wizardCard">
      <Setter Property="Background" Value="#09090B"/>
      <Setter Property="BorderBrush" Value="#27272A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="#F4F4F5"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="16,14"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="VerticalContentAlignment" Value="Top"/>
    </Style>
    <Style Selector="Button.wizardCard:pointerover">
      <Setter Property="Background" Value="#111827"/>
      <Setter Property="BorderBrush" Value="#10B981"/>
    </Style>
    <Style Selector="Button.wizardCardActive">
      <Setter Property="Background" Value="#052E24"/>
      <Setter Property="BorderBrush" Value="#10B981"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="Foreground" Value="#ECFDF5"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="16,14"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="VerticalContentAlignment" Value="Top"/>
    </Style>
    <Style Selector="Border.pipelineNode">
      <Setter Property="Background" Value="#09090B"/>
      <Setter Property="BorderBrush" Value="#27272A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="Opacity" Value="0.62"/>
    </Style>
    <Style Selector="Border.pipelineNodeActive">
      <Setter Property="Background" Value="#064E3B"/>
      <Setter Property="BorderBrush" Value="#10B981"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="Opacity" Value="1.0"/>
    </Style>
  </Application.Styles>
</Application>
