<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DaoStudio.Desktop.ViewModels" xmlns:services="using:DaoStudio.Desktop.Services"
             xmlns:contracts="using:DaoStudio.Contracts"
             x:Name="MaterialsRoot"
             x:Class="DaoStudio.Desktop.Views.MaterialsView" x:DataType="vm:MaterialsViewModel" x:CompileBindings="True">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+Enter" Command="{Binding ApproveBlockCommand}"/>
  </UserControl.KeyBindings>

  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <!-- Cabeçalho + Seletor Segmentado -->
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
      <StackPanel Spacing="3">
        <TextBlock Text="Novels &amp; Mangás" Classes="title"/>
        <TextBlock Text="{Binding SelectedGame.DisplayName, StringFormat='Glossário compartilhado com cache L0/L1: {0}'}" Foreground="#34D399" FontSize="13"/>
      </StackPanel>
      <Border Grid.Column="1" Classes="segmentedBar" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Button Content="Manhua" Classes="chip" Classes.chipActive="{Binding IsManhuaSelected}" Command="{Binding SelectCategoryCommand}" CommandParameter="Manhua"/>
          <Button Content="Webnovel" Classes="chip" Classes.chipActive="{Binding IsWebnovelSelected}" Command="{Binding SelectCategoryCommand}" CommandParameter="Webnovel"/>
          <Button Content="Lore &amp; Wiki" Classes="chip" Classes.chipActive="{Binding IsLoreWikiSelected}" Command="{Binding SelectCategoryCommand}" CommandParameter="LoreWiki"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Importador rápido / Divisor de texto bruto -->
    <Border Grid.Row="1" Classes="panel" Padding="14" Margin="0,0,0,14">
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,130,Auto,Auto">
          <TextBox Text="{Binding RawInputText}" AcceptsReturn="True" MaxHeight="68" Watermark="Cole parágrafos de capítulo ou falas de manhua em chinês (1 bloco por linha)..."/>
          <TextBox Grid.Column="1" Text="{Binding DefaultBubbleMaxChars}" Margin="8,0,0,0" Watermark="Limite balão"/>
          <Button Grid.Column="2" Content="Dividir em Blocos" Classes="primary" Command="{Binding SplitRawTextCommand}" Margin="8,0,0,0"/>
          <Button Grid.Column="3" Content="Recarregar Exemplos" Command="{Binding LoadSampleMaterialsCommand}" Margin="8,0,0,0"/>
        </Grid>
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding StatusMessage}" FontSize="12" Classes="secondary" TextWrapping="Wrap"/>
          <TextBlock Grid.Column="1" Text="{Binding ProgressSummary}" Classes="mono" FontSize="11.5" FontWeight="SemiBold" Foreground="#34D399"/>
        </Grid>
      </StackPanel>
    </Border>

    <!-- Master-Detail -->
    <Grid Grid.Row="2" ColumnDefinitions="310,*">
      <!-- Lista de blocos -->
      <Border Classes="panel" Padding="12" Margin="0,0,14,0">
        <ListBox ItemsSource="{Binding FilteredBlocks}" SelectedItem="{Binding SelectedBlock}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="services:MaterialBlockItem">
              <Grid ColumnDefinitions="Auto,*" Margin="2,4">
                <Border Grid.Column="0" Classes="statusDotApproved" IsVisible="{Binding Approved}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Border Grid.Column="0" Classes="statusDotPending" IsVisible="{Binding !Approved}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel Grid.Column="1" Spacing="2">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Reference}" FontSize="12" FontWeight="SemiBold" Foreground="#EAEAEF" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Text="{Binding BlockType}" Classes="mono" FontSize="10.5" Foreground="#34D399" Margin="8,0,0,0"/>
                  </Grid>
                  <TextBlock Text="{Binding SourceText}" FontSize="12" Classes="secondary" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <!-- Editor Lado a Lado + Exportação Bilíngue -->
      <Grid Grid.Column="1" RowDefinitions="*,Auto">
        <Grid ColumnDefinitions="*,*">
          <Border Classes="panel" Margin="0,0,7,0">
            <Grid RowDefinitions="Auto,*,Auto">
              <StackPanel Spacing="2" Margin="0,0,0,8">
                <TextBlock Text="Original (Chinês)" Classes="section"/>
                <TextBlock Text="{Binding SelectedBlock.Reference, TargetNullValue='Selecione um bloco à esquerda'}" Classes="mono" FontSize="11"/>
              </StackPanel>
              <TextBox Grid.Row="1" Text="{Binding SelectedBlock.SourceText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"/>
              <StackPanel Grid.Row="2" Spacing="6" Margin="0,10,0,0">
                <TextBlock Text="GLOSSÁRIO DETECTADO" Classes="caption"/>
                <ScrollViewer MaxHeight="110">
                  <ItemsControl ItemsSource="{Binding DetectedTerms}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="contracts:GlossaryEntry">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding Zh}" FontSize="12.5" FontWeight="SemiBold"/>
                            <TextBlock Text="·" Classes="secondary"/>
                            <TextBlock Text="{Binding PtBr}" FontSize="12.5" Foreground="#34D399" FontWeight="SemiBold"/>
                          </StackPanel>
                          <Button Grid.Column="1" Content="Inserir" Classes="chip"
                                  Command="{ReflectionBinding DataContext.InsertTermCommand, ElementName=MaterialsRoot}"
                                  CommandParameter="{Binding}"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </StackPanel>
            </Grid>
          </Border>

          <Border Grid.Column="1" Classes="panel" Margin="7,0,0,0">
            <Grid RowDefinitions="Auto,*,Auto">
              <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                <TextBlock Text="Tradução / Adaptação (PT-BR)" Classes="section"/>
                <TextBlock Grid.Column="1" Text="{Binding CharBudgetSummary}" Classes="mono" FontSize="11.5" Foreground="#34D399" VerticalAlignment="Center"/>
              </Grid>
              <TextBox Grid.Row="1" Text="{Binding TranslationText}" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Watermark="Escreva respeitando o orçamento de caracteres do balão ou parágrafo..."/>
              <StackPanel Grid.Row="2" Spacing="6" Margin="0,10,0,0">
                <TextBlock Text="PRÉVIA BILÍNGUE / SCRIPT DE TYPESETTING" Classes="caption"/>
                <TextBox Text="{Binding ExportedPreview}" IsReadOnly="True" AcceptsReturn="True" MaxHeight="110" TextWrapping="Wrap" Watermark="Clique em 'Gerar Script Bilíngue' abaixo para visualizar..."/>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="8" Margin="0,12,0,0">
          <Border Classes="alertError" IsVisible="{Binding ValidationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding ValidationMessage}" Foreground="#FCA5A5" TextWrapping="Wrap" FontSize="12.5"/>
          </Border>
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Text="Aprovações salvam automaticamente no L1 SQLite compartilhado com o modo In-Game." FontSize="12" Classes="secondary" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Gerar Script Bilíngue" Command="{Binding GenerateBilingualExportCommand}" Margin="0,0,8,0"/>
            <Button Grid.Column="2" Content="Aprovar Bloco" Classes="primary" Command="{Binding ApproveBlockCommand}"/>
          </Grid>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
