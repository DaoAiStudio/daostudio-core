<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DaoStudio.Desktop.ViewModels" xmlns:services="using:DaoStudio.Desktop.Services"
             xmlns:contracts="using:DaoStudio.Contracts"
             x:Name="MaterialsRoot"
             x:Class="DaoStudio.Desktop.Views.MaterialsView" x:DataType="vm:MaterialsViewModel" x:CompileBindings="True">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+Enter" Command="{Binding ApproveBlockCommand}"/>
  </UserControl.KeyBindings>

  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <!-- Cabeçalho + Seletor de Tipo de Material -->
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <StackPanel Spacing="4">
        <TextBlock Text="Novels, Mangás &amp; Lore (Módulo Materiais)" Classes="title"/>
        <TextBlock Text="{Binding SelectedGame.DisplayName, StringFormat='Glossário compartilhado com cache L0/L1: {0}'}" Foreground="#6EE7B7" FontSize="13"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Content="Mangá / Manhua (Balões)" Classes="nav" Classes.navActive="{Binding IsManhuaSelected}" Command="{Binding SelectCategoryCommand}" CommandParameter="Manhua"/>
        <Button Content="Webnovel / Light Novel" Classes="nav" Classes.navActive="{Binding IsWebnovelSelected}" Command="{Binding SelectCategoryCommand}" CommandParameter="Webnovel"/>
        <Button Content="Guia &amp; Lore Wiki" Classes="nav" Classes.navActive="{Binding IsLoreWikiSelected}" Command="{Binding SelectCategoryCommand}" CommandParameter="LoreWiki"/>
      </StackPanel>
    </Grid>

    <!-- Importador rápido / Divisor de texto bruto -->
    <Border Grid.Row="1" Classes="panel" Padding="14" Margin="0,0,0,14">
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,140,Auto,Auto">
          <TextBox Text="{Binding RawInputText}" AcceptsReturn="True" MaxHeight="68" Watermark="Cole parágrafos de capítulo ou falas/balões de manhua em chinês (1 bloco por linha)..."/>
          <TextBox Grid.Column="1" Text="{Binding DefaultBubbleMaxChars}" Margin="8,0,0,0" Watermark="Limite balão"/>
          <Button Grid.Column="2" Content="Dividir em Blocos" Classes="primary" Command="{Binding SplitRawTextCommand}" Margin="8,0,0,0"/>
          <Button Grid.Column="3" Content="Recarregar Exemplos" Command="{Binding LoadSampleMaterialsCommand}" Margin="8,0,0,0"/>
        </Grid>
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding StatusMessage}" FontSize="12" Classes="secondary" TextWrapping="Wrap"/>
          <TextBlock Grid.Column="1" Text="{Binding ProgressSummary}" FontSize="12" FontWeight="SemiBold" Foreground="#6EE7B7"/>
        </Grid>
      </StackPanel>
    </Border>

    <!-- Master-Detail -->
    <Grid Grid.Row="2" ColumnDefinitions="310,*">
      <!-- Lista de blocos -->
      <Border Classes="panel" Padding="12" Margin="0,0,14,0">
        <ListBox ItemsSource="{Binding FilteredBlocks}" SelectedItem="{Binding SelectedBlock}" Background="#09090B" CornerRadius="6">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="services:MaterialBlockItem">
              <StackPanel Spacing="3" Margin="4">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding Reference}" FontSize="12" FontWeight="SemiBold"/>
                  <TextBlock Grid.Column="1" Text="{Binding BlockType}" FontSize="11" Foreground="#6EE7B7"/>
                </Grid>
                <TextBlock Text="{Binding SourceText}" FontSize="12" Foreground="#A1A1AA" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Approved, StringFormat='Aprovado: {0}'}" FontSize="11" Foreground="#71717A"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <!-- Editor Lado a Lado + Exportação Bilíngue -->
      <Grid Grid.Column="1" RowDefinitions="*,Auto">
        <Grid ColumnDefinitions="*,*">
          <Border Classes="panel" Margin="0,0,8,0">
            <Grid RowDefinitions="Auto,*,Auto">
              <StackPanel Spacing="2" Margin="0,0,0,8">
                <TextBlock Text="Texto Original (ZH)" Classes="section"/>
                <TextBlock Text="{Binding SelectedBlock.Reference, TargetNullValue='Selecione um bloco à esquerda'}" FontSize="11" Classes="secondary"/>
              </StackPanel>
              <TextBox Grid.Row="1" Text="{Binding SelectedBlock.SourceText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"/>
              <StackPanel Grid.Row="2" Spacing="6" Margin="0,10,0,0">
                <TextBlock Text="TERMOS DO GLOSSÁRIO DETECTADOS" Classes="caption"/>
                <ScrollViewer MaxHeight="110">
                  <ItemsControl ItemsSource="{Binding DetectedTerms}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="contracts:GlossaryEntry">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding Zh}" FontWeight="SemiBold"/>
                            <TextBlock Text="→" Classes="secondary"/>
                            <TextBlock Text="{Binding PtBr}" Foreground="#6EE7B7"/>
                          </StackPanel>
                          <Button Grid.Column="1" Content="+ Inserir" Classes="chip"
                                  Command="{ReflectionBinding DataContext.InsertTermCommand, ElementName=MaterialsRoot}"
                                  CommandParameter="{Binding}"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </StackPanel>
            </Grid>
          </Border>

          <Border Grid.Column="1" Classes="panel" Margin="8,0,0,0">
            <Grid RowDefinitions="Auto,*,Auto">
              <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                <TextBlock Text="Tradução / Adaptação (PT-BR)" Classes="section"/>
                <TextBlock Grid.Column="1" Text="{Binding CharBudgetSummary}" FontSize="12" Foreground="#6EE7B7" VerticalAlignment="Center"/>
              </Grid>
              <TextBox Grid.Row="1" Text="{Binding TranslationText}" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Watermark="Escreva respeitando o orçamento de caracteres do balão ou parágrafo..."/>
              <StackPanel Grid.Row="2" Spacing="6" Margin="0,10,0,0">
                <TextBlock Text="PRÉVIA BILÍNGUE / SCRIPT DE TYPESETTING" Classes="caption"/>
                <TextBox Text="{Binding ExportedPreview}" IsReadOnly="True" AcceptsReturn="True" MaxHeight="110" TextWrapping="Wrap" Watermark="Clique em 'Gerar Script Bilíngue' abaixo para visualizar..."/>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="8" Margin="0,12,0,0">
          <Border Classes="alertError" IsVisible="{Binding ValidationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding ValidationMessage}" Foreground="#FCA5A5" TextWrapping="Wrap" FontSize="13"/>
          </Border>
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Text="Aprovações salvam automaticamente no L1 SQLite compartilhado com o modo In-Game." FontSize="12" Classes="secondary" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Gerar Script Bilíngue" Command="{Binding GenerateBilingualExportCommand}" Margin="0,0,8,0"/>
            <Button Grid.Column="2" Content="Aprovar Bloco   Ctrl+Enter" Classes="primary" Command="{Binding ApproveBlockCommand}"/>
          </Grid>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
