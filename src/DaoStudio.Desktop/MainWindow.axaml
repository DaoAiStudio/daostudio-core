<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DaoStudio.Desktop.ViewModels" xmlns:views="using:DaoStudio.Desktop.Views"
        xmlns:contracts="using:DaoStudio.Contracts"
        x:Class="DaoStudio.Desktop.MainWindow" x:DataType="vm:MainWindowViewModel" x:CompileBindings="True"
        Icon="avares://DaoStudio.Desktop/Assets/daostudio-logo.ico"
        Title="DaoStudio Core — Translation Suite" Width="1380" Height="880" MinWidth="1040" MinHeight="720">
  <Window.DataTemplates>
    <DataTemplate DataType="vm:TourViewModel"><views:TourView/></DataTemplate>
    <DataTemplate DataType="vm:LauncherViewModel"><views:LauncherView/></DataTemplate>
    <DataTemplate DataType="vm:WorkbenchViewModel"><views:WorkbenchView/></DataTemplate>
    <DataTemplate DataType="vm:MaterialsViewModel"><views:MaterialsView/></DataTemplate>
  </Window.DataTemplates>
  <Grid ColumnDefinitions="252,*">
    <Border Background="#0A0A0E" BorderBrush="#16161F" BorderThickness="0,0,1,0" Padding="14,18">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Spacing="20">
          <!-- Brand Header -->
          <StackPanel Orientation="Horizontal" Spacing="10" Margin="2,0">
            <Border CornerRadius="8" BorderBrush="#222230" BorderThickness="1" Background="#070709" Width="32" Height="32" ClipToBounds="True">
              <Image Source="avares://DaoStudio.Desktop/Assets/daostudio-logo.png" Width="30" Height="30" Stretch="UniformToFill"/>
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="1">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="DaoStudio" FontSize="15" FontWeight="SemiBold" Foreground="#F4F4F6"/>
                <Border Classes="badge" Padding="6,1" VerticalAlignment="Center">
                  <TextBlock Text="CORE" Classes="mono" FontSize="9.5" FontWeight="SemiBold" Foreground="#34D399"/>
                </Border>
              </StackPanel>
              <TextBlock Text="Translation Suite" FontSize="11" Foreground="#5C5C6E"/>
            </StackPanel>
          </StackPanel>

          <!-- Universe Selector -->
          <StackPanel Spacing="6">
            <TextBlock Text="UNIVERSO ATIVO" Classes="caption" Margin="2,0"/>
            <ComboBox ItemsSource="{Binding AvailableGames}" SelectedItem="{Binding SelectedGame}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="contracts:GameProfileManifest">
                  <StackPanel Spacing="1">
                    <TextBlock Text="{Binding DisplayName}" FontSize="12.5" FontWeight="SemiBold" Foreground="#EAEAEF" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Engine}" Classes="mono" FontSize="10.5" Foreground="#6C6C7E"/>
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>

          <!-- Clean Workspace Navigation -->
          <StackPanel Spacing="4">
            <TextBlock Text="WORKSPACE" Classes="caption" Margin="2,0,0,4"/>

            <Button Classes="nav" Classes.navActive="{Binding IsTourActive}" Command="{Binding ShowTourCommand}" HorizontalAlignment="Stretch">
              <Grid ColumnDefinitions="26,*">
                <TextBlock Grid.Column="0" Text="00" Classes="mono" FontSize="11" Foreground="#34D399" VerticalAlignment="Top" Margin="0,2,0,0"/>
                <StackPanel Grid.Column="1" Spacing="1">
                  <TextBlock Text="Assistente Inicial" FontSize="12.5" FontWeight="SemiBold"/>
                  <TextBlock Text="Fluxo sob medida" FontSize="11" Foreground="#6C6C7E"/>
                </StackPanel>
              </Grid>
            </Button>

            <Button Classes="nav" Classes.navActive="{Binding IsLauncherActive}" Command="{Binding ShowLauncherCommand}" HorizontalAlignment="Stretch">
              <Grid ColumnDefinitions="26,*">
                <TextBlock Grid.Column="0" Text="01" Classes="mono" FontSize="11" Foreground="#6C6C7E" VerticalAlignment="Top" Margin="0,2,0,0"/>
                <StackPanel Grid.Column="1" Spacing="1">
                  <TextBlock Text="In-Game Bridge" FontSize="12.5" FontWeight="SemiBold"/>
                  <TextBlock Text="Patch &amp; tradução ao vivo" FontSize="11" Foreground="#6C6C7E"/>
                </StackPanel>
              </Grid>
            </Button>

            <Button Classes="nav" Classes.navActive="{Binding IsWorkbenchActive}" Command="{Binding ShowWorkbenchCommand}" HorizontalAlignment="Stretch">
              <Grid ColumnDefinitions="26,*">
                <TextBlock Grid.Column="0" Text="02" Classes="mono" FontSize="11" Foreground="#6C6C7E" VerticalAlignment="Top" Margin="0,2,0,0"/>
                <StackPanel Grid.Column="1" Spacing="1">
                  <TextBlock Text="Studio CAT" FontSize="12.5" FontWeight="SemiBold"/>
                  <TextBlock Text="Segmentos, tags &amp; QA" FontSize="11" Foreground="#6C6C7E"/>
                </StackPanel>
              </Grid>
            </Button>

            <Button Classes="nav" Classes.navActive="{Binding IsMaterialsActive}" Command="{Binding ShowMaterialsCommand}" HorizontalAlignment="Stretch">
              <Grid ColumnDefinitions="26,*">
                <TextBlock Grid.Column="0" Text="03" Classes="mono" FontSize="11" Foreground="#6C6C7E" VerticalAlignment="Top" Margin="0,2,0,0"/>
                <StackPanel Grid.Column="1" Spacing="1">
                  <TextBlock Text="Novels &amp; Mangás" FontSize="12.5" FontWeight="SemiBold"/>
                  <TextBlock Text="Scanlation, capítulos &amp; lore" FontSize="11" Foreground="#6C6C7E"/>
                </StackPanel>
              </Grid>
            </Button>
          </StackPanel>
        </StackPanel>

        <!-- Compact Bottom Status Card -->
        <Border DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Classes="metric">
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Border Classes="statusDotApproved"/>
              <TextBlock Text="SESSÃO ATIVA" Classes="caption"/>
            </StackPanel>
            <TextBlock Text="{Binding SelectedGame.DisplayName}" FontSize="12.5" FontWeight="SemiBold" Foreground="#EAEAEF" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Tour.InferredPersonaBadge}" FontSize="11" Foreground="#34D399" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Launcher.DetectionStatusBadge}" Classes="mono" FontSize="10.5" Foreground="#6C6C7E" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </DockPanel>
    </Border>
    <ContentControl Grid.Column="1" Content="{Binding CurrentView}" Margin="24,20"/>
  </Grid>
</Window>
